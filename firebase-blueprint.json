{
  "entities": {
    "Message": {
      "title": "Message",
      "description": "A chat message",
      "type": "object",
      "properties": {
        "text": { "type": "string", "maxLength": 5000 },
        "userId": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["text", "userId", "createdAt"]
    },
    "Signal": {
      "title": "Signal",
      "description": "WebRTC signaling message",
      "type": "object",
      "properties": {
        "type": { "type": "string", "maxLength": 50 },
        "sourceDeviceId": { "type": "string", "maxLength": 100 },
        "targetDeviceId": { "type": "string", "maxLength": 100 },
        "sdp": { "type": "string", "maxLength": 10000 },
        "candidate": { "type": "string", "maxLength": 5000 },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["type", "sourceDeviceId", "targetDeviceId", "createdAt"]
    },
    "RagSource": {
      "title": "RagSource",
      "description": "RAG knowledge source synchronization record",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 20 },
        "docsCount": { "type": "number" },
        "lastSync": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["name", "type", "status", "docsCount", "updatedAt"]
    }
  },
  "firestore": {
    "messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "User messages"
    },
    "signals/{signalId}": {
      "schema": { "$ref": "#/entities/Signal" },
      "description": "WebRTC signaling messages"
    },
    "rag_sources/{sourceId}": {
      "schema": { "$ref": "#/entities/RagSource" },
      "description": "Connected RAG sources and indexing statuses"
    }
  }
}
